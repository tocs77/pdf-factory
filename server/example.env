APP_PORT=3000
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pdf_factory
MATCHER_URL=http://matcher:8000
# Optional: path to the dwg2pdf binary (defaults to a local cargo release
# build at ../dwg2pdf/target/release, then PATH)
# DWG2PDF_PATH=/usr/local/bin/dwg2pdf
# Paper sheet for DWG->PDF conversion (a0-a5, letter, legal, extents).
# Landscape is used unless DWG2PDF_LANDSCAPE=0.
# DWG2PDF_PAPER=a0
# DWG2PDF_LANDSCAPE=1